# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="app"
POSTGRES_HOST="db"
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_KV_NAMESPACE_ID=""

# llama-server (via llama-swap)
LLAMA_SERVER_BASE_URL="http://llama-swap:8080"
LLAMA_SERVER_MEMORY_RESERVATION=16g
LLAMA_SERVER_MEMORY_LIMIT=24g
# If using a private model (such as gemma3:4b-it-qat), set this to the Hugging Face access token with permissions to access the model.
HF_ACCESS_TOKEN=""
# Override if your host doesn't have an NVIDIA GPU (e.g. "ghcr.io/mostlygeek/llama-swap:cpu").
# LLAMA_SWAP_IMAGE="ghcr.io/mostlygeek/llama-swap:cuda"

# Ollama (optional — only used with `docker compose --profile ollama up`)
OLLAMA_BASE_URL="http://ollama:11435"
OLLAMA_MEMORY_RESERVATION=16g
OLLAMA_MEMORY_LIMIT=24g
OLLAMA_CONTEXT_LENGTH=16384

# Documentation (optional — directory holding the in-app user guides; defaults to docs/guides)
# DOCS_GUIDES_DIR="docs/guides"
